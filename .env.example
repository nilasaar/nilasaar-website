# Copy these into Vercel: Project -> Settings -> Environment Variables.
# Never commit real values — this file is just a template.

# Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay Dashboard -> Settings -> Webhooks -> the secret you set when
# creating the https://nilasaar.in/api/webhook webhook
RAZORPAY_WEBHOOK_SECRET=

# Resend (resend.com) -> API Keys
RESEND_API_KEY=

# Must be an email/domain verified in Resend
ORDER_EMAIL_FROM=orders@nilasaar.in
# Where order notifications get sent — your inbox
ORDER_EMAIL_TO=bhavirishi10@gmail.com
